; If user systemd instance is lingering, this service runs tmux on boot when
; enabled; otherwise, on login.

; Based on
; https://wiki.archlinux.org/title/Tmux#Start_with_systemd_user_instance_and_socket_activation

[Unit]
Description=Terminal Multiplexer (listen on: %i)
Documentation=man:tmux(1)
Requires=tmux@%i.socket

[Service]
Environment="TMUX_SERVER_ARGS=-f %h/.config/tmux/tmux.conf"
ExecStart=tmux -D $TMUX_SERVER_ARGS
ExecStartPost=tmux -L%i start
Slice=app-tmux-%i.slice

[Install]
WantedBy=default.target
Also=tmux@%i.socket
